# ==============================================
# Environment Configuration
# ==============================================
# Copy this file to .env and update the values
# for your local development environment.
# ==============================================

# Application Environment
# Options: dev, staging, prod
NODE_ENV=dev

# Logging Level
# Options: debug, info, warn, error
LOG_LEVEL=debug

# Service Name (used for logging and tracing)
SERVICE_NAME=serverless-typescript-api

# ==============================================
# AWS Configuration (for local development)
# ==============================================
# These are dummy values for local development
# Real credentials are NOT needed when running locally

AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

# ==============================================
# Serverless Offline Configuration
# ==============================================

# Local server port
SERVERLESS_PORT=3000

# ==============================================
# Future Configuration (when needed)
# ==============================================

# Database URL (if using a database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis URL (if using Redis)
# REDIS_URL=redis://localhost:6379

# External API Keys (if integrating with external services)
# EXTERNAL_API_KEY=your-api-key-here
